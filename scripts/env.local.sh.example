# 本机覆盖示例：复制成同目录下的 env.local.sh 后按需修改（env.local.sh 已被 .gitignore 忽略）
#
# 1) 指向你自己的虚拟环境里的 python（Windows 形如 .../Scripts/python.exe，macOS/Linux 形如 .../bin/python）
PY="<改成你的 venv python 的绝对路径>"

# 2) 可选：覆盖镜像 / 线程数 / pip 源
# HF_ENDPOINT="https://hf-mirror.com"
# OMP_NUM_THREADS="12"
# PIP_INDEX_URL="https://pypi.tuna.tsinghua.edu.cn/simple"